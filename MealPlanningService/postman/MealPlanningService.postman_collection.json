{
  "info": {
    "name": "Meal Planning Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Clients",
      "item": [
        {
          "name": "Register client A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "clients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{nameA}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"clientId\", b.client_id);",
                  "pm.collectionVariables.set(\"apiKey\", b.api_key);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now();",
                  "pm.collectionVariables.set(\"nameA\", \"postman-a-\" + n);",
                  "pm.collectionVariables.set(\"nameB\", \"postman-b-\" + n);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register client B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "clients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{nameB}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"otherClientId\", b.client_id);",
                  "pm.collectionVariables.set(\"otherApiKey\", b.api_key);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register duplicate name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "clients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{nameA}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register blank name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "clients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"  \"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error message\", () => pm.expect(pm.response.json().error).to.eql(\"name is required and must not be blank\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Meal plans",
      "item": [
        {
          "name": "POST mealplan (needs mealplan-demo profile)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/clients/{{clientId}}/mealplan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "clients",
                "{{clientId}}",
                "mealplan"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"time_frame\":\"day\",\"max_calories\":1800,\"diet_type\":[\"vegetarian\"],\"allergens\":[\"peanuts\"],\"max_prep_time_mins\":40}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"mealPlanId\", b.id);",
                  "pm.test(\"plan belongs to client\", () => pm.expect(b.clientId).to.eql(pm.collectionVariables.get(\"clientId\")));",
                  "pm.test(\"plan has a schedule\", () => pm.expect(b.schedule).to.have.length.above(0));"
                ]
              }
            }
          ]
        },
